# ImpactIQ Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# NASA API key — register free at https://api.nasa.gov
# Using DEMO_KEY is heavily rate-limited (30 req/hr) and will break during
# active development. Register a real key on day one.
NASA_API_KEY=DEMO_KEY

# watsonx.ai credentials — obtain from your IBM watsonx project settings
# https://dataplatform.cloud.ibm.com → Project → Manage → General → Project ID
WATSONX_API_KEY=
WATSONX_PROJECT_ID= 

# IBM watsonx.ai endpoint (default: Dallas region)
# Other regions: https://ibm.github.io/watson-machine-learning-sdk/setup_cloud.html
WATSONX_URL=https://us-south.ml.cloud.ibm.com
